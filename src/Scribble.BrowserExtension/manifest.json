{
  "manifest_version": 3,
  "name": "Scribble for the web",
  "short_name": "Scribble",
  "description": "Chat about the current page and let Scribble operate bounded inactive work tabs.",
  "version": "1.7.0",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "debugger",
    "nativeMessaging",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Scribble"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; connect-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
