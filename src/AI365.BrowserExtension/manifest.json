{
  "manifest_version": 3,
  "name": "AI365 for the web",
  "short_name": "AI365",
  "description": "Chat with AI365 about page content that you explicitly attach.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AI365"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; connect-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
